{
	"schemaVersion": 1,
	"id": "blib",
	"version": "${version}",
	"name": "${mod_name}",
	"description": "${description}",
	"accessWidener": "blib.accesswidener",
	"authors": ["Stargazer Studios"],
	"contact": {
		"homepage": "https://www.curseforge.com/minecraft/mc-mods/blib",
		"sources": "https://github.com/Stargazer-Studios/BLib"
	},
	"license": "${license}",
	"icon": "${icon}",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.blib.fabric.internal.BLibFabric"
		],
		"client": [
			"com.blib.fabric.internal.client.BLibFabricClient"
		],
		"fabric-datagen": [
			"com.blib.fabric.internal.data.BLibDataGenerator"
		],
		"rei_client": [
			"com.blib.internal.client.viewer.rei.BLibReiPlugin"
		],
		"jei_mod_plugin": [
			"com.blib.internal.client.viewer.jei.BLibJeiPlugin"
		],
		"emi": [
			"com.blib.fabric.client.viewer.BLibEmiPlugin"
		]
	},
	"mixins": [
		"${mod_id}.mixins.json",
		"${mod_id}.compat.mixins.json",
		"${mod_id}.fabric.mixins.json"
	],
	"depends": {
		"fabricloader": ">=${fabric_loader_version}",
		"minecraft": "~${minecraft_version}",
		"java": ">=${java_version}",
		"fabric-api": "*"
	}
}
